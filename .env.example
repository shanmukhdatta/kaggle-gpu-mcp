# Copy to .env for your own records, then export variables into your shell.
# This project does NOT load .env automatically.
KGM_WORKSPACE=./workspace
KGM_KAGGLE_USERNAME=your_kaggle_username
KGM_KAGGLE_BIN=kaggle
# Only enable after reviewing the requested code; prevents clients silently running jobs
KGM_ALLOW_SUBMISSIONS=0
KGM_POLL_SECONDS=45
KGM_MAX_ACTIVE_JOBS=1
KGM_MAX_ARTIFACT_BYTES=536870912
KGM_NOTIFY_EMAIL=
KGM_SMTP_HOST=
KGM_SMTP_PORT=587
KGM_SMTP_USERNAME=
KGM_SMTP_PASSWORD=
KGM_SMTP_SENDER=
# KGM_SMTP_USE_SSL=0
